.PHONY: sft dpo simpo orpo eval judge safety serve demo lint test test-fast data-sft-fast data-dpo-fast results portfolio eval-split \
 train-full_eval-balanced build-train-full_eval-balanced build-train-full_eval-balanced-nosimpo \
 train-credible_eval-balanced build-train-credible_eval-balanced build-train-credible_eval-balanced-nosimpo
sft: ; ALIGNTUNE_OPTIM_8BIT=1 ALIGNTUNE_USE_GC=1 TOKENIZERS_PARALLELISM=false python -m scripts.train_sft --config configs/base.yaml --preset balanced --autosave_steps 50 --autosave_keep 2
dpo: ; ALIGNTUNE_OPTIM_8BIT=1 ALIGNTUNE_USE_GC=1 TOKENIZERS_PARALLELISM=false python -m scripts.train_pref --config configs/base.yaml --preset balanced --algo dpo --beta 0.1 --sft_ckpt outputs/sft/Llama-3.1-8B-Instruct-lora --autosave_steps 50
simpo: ; ALIGNTUNE_OPTIM_8BIT=1 ALIGNTUNE_USE_GC=1 TOKENIZERS_PARALLELISM=false python -m scripts.train_pref --config configs/base.yaml --preset balanced --algo simpo --beta 2.0 --sft_ckpt outputs/sft/Llama-3.1-8B-Instruct-lora --autosave_steps 50
orpo: ; ALIGNTUNE_OPTIM_8BIT=1 ALIGNTUNE_USE_GC=1 TOKENIZERS_PARALLELISM=false python -m scripts.train_pref --config configs/base.yaml --preset balanced --algo orpo --sft_ckpt outputs/sft/Llama-3.1-8B-Instruct-lora --autosave_steps 50
eval: ; python -m scripts.eval --config configs/base.yaml --ckpt outputs/dpo/Llama-3.1-8B-Instruct-lora-dpo
judge-prompts: ; python -m data.build_judge_random_1000
judge: ; TOKENIZERS_PARALLELISM=false python -m eval.judge_winrate_mini --ckpt_a outputs/sft/Llama-3.1-8B-Instruct-lora --ckpt_b outputs/dpo/Llama-3.1-8B-Instruct-lora-dpo --prompts_file eval/prompts/prompts_1000.txt --n 1000 --temp 0.0 --judge_mode score --score_tiebreaker --score_epsilon 0.5 --save_cases reports/judge_cases.1000.jsonl
judge-only: ; TOKENIZERS_PARALLELISM=false python -m eval.judge_winrate_mini --judge_only_cases reports/judge_cases.1000.jsonl --n 1000 --judge meta-llama/Llama-3.2-1B-Instruct --temp 0.0 --judge_mode score --score_epsilon 0.5 --score_tiebreaker
safety: ; TOKENIZERS_PARALLELISM=false python -m eval.safety_check --ckpt outputs/dpo/Llama-3.1-8B-Instruct-lora-dpo
serve: ; uvicorn api.server:app --reload
demo: ; python -m app.demo --ckpt outputs/dpo/Llama-3.1-8B-Instruct-lora-dpo --base meta-llama/Llama-3.1-8B-Instruct
lint: ; flake8 scripts api app eval
test: ; pytest -q
test-fast: ; BASE=TinyLlama/TinyLlama-1.1B-Chat-v1.0 pytest -q tests
results: ; python -m scripts.make_results --ablation reports/ablation_summary.json --eval reports/eval_report.json --out_md reports/RESULTS.md
portfolio: ; python -m scripts.portfolio_export --out ./portfolio.zip
eval-split: ; python -m scripts.split_jsonl_eval --inp data/pack/sft.jsonl --out data/pack/sft.eval.jsonl --n 400 --bins 5
data-sft-fast: ; python -m data.build_sft_pack --preset fast --out data/pack/sft.fast.jsonl
data-dpo-fast: ; python -m data.build_dpo_ufb_only --preset fast --out data/pack/dpo.fast.jsonl

############################################################
# RAG add-on
############################################################

rag-build:
	python -m scripts.rag_build --src docs --collection default --chunk_tokens 300 --overlap_tokens 40

rag-qa:
	python -m scripts.rag_query --collection default --query "What is this project about?"

serve-rag:
	RAG_ENABLED=1 uvicorn api.server:app --reload

############################################################
# Full Eval flows (34K)
############################################################

# SFT -> SimPO -> mine -> DPO polish (balanced) — Full Eval (34k)
train-full_eval-balanced:
	ALIGNTUNE_OPTIM_8BIT=1 ALIGNTUNE_USE_GC=1 TOKENIZERS_PARALLELISM=false python -m scripts.train_sft --config configs/base.yaml --preset balanced --autosave_steps 50 --autosave_keep 2
	ALIGNTUNE_OPTIM_8BIT=1 ALIGNTUNE_USE_GC=1 TOKENIZERS_PARALLELISM=false python -m scripts.train_pref --config configs/base.yaml --preset balanced --algo simpo --beta 2.0 --sft_ckpt outputs/sft/Llama-3.1-8B-Instruct-lora --autosave_steps 50
	TOKENIZERS_PARALLELISM=false python -m scripts.mine_hard_pairs --ckpt outputs/simpo/Llama-3.1-8B-Instruct-lora-simpo --in_file data/pack/dpo.jsonl --out_file data/pack/dpo.hard15k.jsonl --top_k 15000 --max_length 1024
	ALIGNTUNE_OPTIM_8BIT=1 ALIGNTUNE_USE_GC=1 TOKENIZERS_PARALLELISM=false python -m scripts.train_pref --config configs/base.yaml --preset balanced --algo dpo --beta 0.1 --sft_ckpt outputs/simpo/Llama-3.1-8B-Instruct-lora-simpo --train_file data/pack/dpo.hard15k.jsonl --autosave_steps 50
	TOKENIZERS_PARALLELISM=false python -m scripts.run_ablation --config configs/base.yaml --ckpt outputs/sft/Llama-3.1-8B-Instruct-lora outputs/simpo/Llama-3.1-8B-Instruct-lora-simpo outputs/dpo/Llama-3.1-8B-Instruct-lora-dpo --labels SFT SimPO DPO
	TOKENIZERS_PARALLELISM=false python -m eval.judge_winrate_mini --ckpt_a outputs/sft/Llama-3.1-8B-Instruct-lora --ckpt_b outputs/dpo/Llama-3.1-8B-Instruct-lora-dpo --prompts_file eval/prompts/prompts_1000.txt --n 1000 --temp 0.0 --judge_mode score --score_tiebreaker --score_epsilon 0.5 --save_cases reports/judge_cases.1000.jsonl
	TOKENIZERS_PARALLELISM=false python -m eval.safety_check --ckpt_a outputs/sft/Llama-3.1-8B-Instruct-lora --ckpt_b outputs/dpo/Llama-3.1-8B-Instruct-lora-dpo
	python -m scripts.make_results --ablation reports/ablation_summary.json --eval reports/eval_report.json --out_md reports/RESULTS.md
	python -m scripts.portfolio_export --out ./portfolio.zip

# Build data (balanced) then run SFT -> SimPO -> mine -> DPO polish — Full Eval (34k)
build-train-full_eval-balanced:
	MAX_SFT=34000 python -m data.build_sft_pack --preset balanced --out data/pack/sft.jsonl
	python -m data.build_dpo_ufb_only --preset balanced --out data/pack/dpo.jsonl
	ALIGNTUNE_OPTIM_8BIT=1 ALIGNTUNE_USE_GC=1 TOKENIZERS_PARALLELISM=false python -m scripts.train_sft --config configs/base.yaml --preset balanced --autosave_steps 50 --autosave_keep 2
	ALIGNTUNE_OPTIM_8BIT=1 ALIGNTUNE_USE_GC=1 TOKENIZERS_PARALLELISM=false python -m scripts.train_pref --config configs/base.yaml --preset balanced --algo simpo --beta 2.0 --sft_ckpt outputs/sft/Llama-3.1-8B-Instruct-lora --autosave_steps 50
	TOKENIZERS_PARALLELISM=false python -m scripts.mine_hard_pairs --ckpt outputs/simpo/Llama-3.1-8B-Instruct-lora-simpo --in_file data/pack/dpo.jsonl --out_file data/pack/dpo.hard15k.jsonl --top_k 15000 --max_length 1024
	ALIGNTUNE_OPTIM_8BIT=1 ALIGNTUNE_USE_GC=1 TOKENIZERS_PARALLELISM=false python -m scripts.train_pref --config configs/base.yaml --preset balanced --algo dpo --beta 0.1 --sft_ckpt outputs/simpo/Llama-3.1-8B-Instruct-lora-simpo --train_file data/pack/dpo.hard15k.jsonl --autosave_steps 50
	TOKENIZERS_PARALLELISM=false python -m scripts.run_ablation --config configs/base.yaml --ckpt outputs/sft/Llama-3.1-8B-Instruct-lora outputs/simpo/Llama-3.1-8B-Instruct-lora-simpo outputs/dpo/Llama-3.1-8B-Instruct-lora-dpo --labels SFT SimPO DPO
	TOKENIZERS_PARALLELISM=false python -m eval.judge_winrate_mini --ckpt_a outputs/sft/Llama-3.1-8B-Instruct-lora --ckpt_b outputs/dpo/Llama-3.1-8B-Instruct-lora-dpo --prompts_file eval/prompts/prompts_1000.txt --n 1000 --temp 0.0 --judge_mode score --score_tiebreaker --score_epsilon 0.5 --save_cases reports/judge_cases.1000.jsonl
	TOKENIZERS_PARALLELISM=false python -m eval.safety_check --ckpt_a outputs/sft/Llama-3.1-8B-Instruct-lora --ckpt_b outputs/dpo/Llama-3.1-8B-Instruct-lora-dpo
	python -m scripts.make_results --ablation reports/ablation_summary.json --eval reports/eval_report.json --out_md reports/RESULTS.md
	python -m scripts.portfolio_export --out ./portfolio.zip

# Same as above but skips SimPO (SFT -> mine -> DPO polish) — Full Eval (34k)
build-train-full_eval-balanced-nosimpo:
	MAX_SFT=34000 python -m data.build_sft_pack --preset balanced --out data/pack/sft.jsonl
	python -m data.build_dpo_ufb_only --preset balanced --out data/pack/dpo.jsonl
	ALIGNTUNE_OPTIM_8BIT=1 ALIGNTUNE_USE_GC=1 TOKENIZERS_PARALLELISM=false python -m scripts.train_sft --config configs/base.yaml --preset balanced --autosave_steps 50 --autosave_keep 2
	ALIGNTUNE_OPTIM_8BIT=1 ALIGNTUNE_USE_GC=1 TOKENIZERS_PARALLELISM=false python -m scripts.train_pref --config configs/base.yaml --preset balanced --algo dpo --beta 0.1 --sft_ckpt outputs/sft/Llama-3.1-8B-Instruct-lora --train_file data/pack/dpo.jsonl --autosave_steps 50
	python -m scripts.run_ablation --config configs/base.yaml --ckpt outputs/sft/Llama-3.1-8B-Instruct-lora outputs/dpo/Llama-3.1-8B-Instruct-lora-dpo --labels SFT DPO
	TOKENIZERS_PARALLELISM=false python -m eval.judge_winrate_mini --ckpt_a outputs/sft/Llama-3.1-8B-Instruct-lora --ckpt_b outputs/dpo/Llama-3.1-8B-Instruct-lora-dpo --prompts_file eval/prompts/prompts_1000.txt --n 1000 --temp 0.0 --judge_mode score --score_tiebreaker --score_epsilon 0.5 --save_cases reports/judge_cases.1000.jsonl
	TOKENIZERS_PARALLELISM=false python -m eval.safety_check --ckpt_a outputs/sft/Llama-3.1-8B-Instruct-lora --ckpt_b outputs/dpo/Llama-3.1-8B-Instruct-lora-dpo
	python -m scripts.make_results --ablation reports/ablation_summary.json --eval reports/eval_report.json --out_md reports/RESULTS.md
	python -m scripts.portfolio_export --out ./portfolio.zip

############################################################
# Credible Eval flows (Balanced 400 + Long 100)
############################################################

train-credible_eval-balanced:
	ALIGNTUNE_OPTIM_8BIT=1 ALIGNTUNE_USE_GC=1 TOKENIZERS_PARALLELISM=false python -m scripts.train_sft --config configs/base.yaml --preset balanced --autosave_steps 50 --autosave_keep 2
	ALIGNTUNE_OPTIM_8BIT=1 ALIGNTUNE_USE_GC=1 TOKENIZERS_PARALLELISM=false python -m scripts.train_pref --config configs/base.yaml --preset balanced --algo simpo --beta 2.0 --sft_ckpt outputs/sft/Llama-3.1-8B-Instruct-lora --autosave_steps 50
	TOKENIZERS_PARALLELISM=false python -m scripts.mine_hard_pairs --ckpt outputs/simpo/Llama-3.1-8B-Instruct-lora-simpo --in_file data/pack/dpo.jsonl --out_file data/pack/dpo.hard15k.jsonl --top_k 15000 --max_length 1024
	ALIGNTUNE_OPTIM_8BIT=1 ALIGNTUNE_USE_GC=1 TOKENIZERS_PARALLELISM=false python -m scripts.train_pref --config configs/base.yaml --preset balanced --algo dpo --beta 0.1 --sft_ckpt outputs/simpo/Llama-3.1-8B-Instruct-lora-simpo --train_file data/pack/dpo.hard15k.jsonl --autosave_steps 50
	python -m scripts.split_jsonl_eval --inp data/pack/sft.jsonl --out data/pack/sft.eval.400.jsonl --n 400 --bins 8
	python -m scripts.build_long_eval --inp data/pack/sft.jsonl --out data/pack/sft.eval.long100.jsonl --n 100
	TOKENIZERS_PARALLELISM=false python -m scripts.run_ablation --config configs/base.yaml --eval_file data/pack/sft.eval.400.jsonl --ckpt outputs/sft/Llama-3.1-8B-Instruct-lora outputs/simpo/Llama-3.1-8B-Instruct-lora-simpo outputs/dpo/Llama-3.1-8B-Instruct-lora-dpo --labels SFT SimPO DPO --out reports/ablation_summary.json
	TOKENIZERS_PARALLELISM=false python -m scripts.run_ablation --config configs/base.yaml --eval_file data/pack/sft.eval.long100.jsonl --batch_size 2 --ckpt outputs/sft/Llama-3.1-8B-Instruct-lora outputs/simpo/Llama-3.1-8B-Instruct-lora-simpo outputs/dpo/Llama-3.1-8B-Instruct-lora-dpo --labels "SFT (long)" "SimPO (long)" "DPO (long)" --out reports/ablation_long_summary.json
	TOKENIZERS_PARALLELISM=false python -m eval.judge_winrate_mini --ckpt_a outputs/sft/Llama-3.1-8B-Instruct-lora --ckpt_b outputs/dpo/Llama-3.1-8B-Instruct-lora-dpo --prompts_file eval/prompts/prompts_1000.txt --n 1000 --temp 0.0 --judge_mode score --score_tiebreaker --score_epsilon 0.5 --save_cases reports/judge_cases.1000.jsonl
	TOKENIZERS_PARALLELISM=false python -m eval.safety_check --ckpt_a outputs/sft/Llama-3.1-8B-Instruct-lora --ckpt_b outputs/dpo/Llama-3.1-8B-Instruct-lora-dpo
	python -m scripts.make_results --ablation reports/ablation_summary.json --ablation_long reports/ablation_long_summary.json --eval reports/eval_report.json --out_md reports/RESULTS.md
	python -m scripts.portfolio_export --out ./portfolio.zip

build-train-credible_eval-balanced:
	MAX_SFT=34000 python -m data.build_sft_pack --preset balanced --out data/pack/sft.jsonl
	python -m data.build_dpo_ufb_only --preset balanced --out data/pack/dpo.jsonl
	ALIGNTUNE_OPTIM_8BIT=1 ALIGNTUNE_USE_GC=1 TOKENIZERS_PARALLELISM=false python -m scripts.train_sft --config configs/base.yaml --preset balanced --autosave_steps 50 --autosave_keep 2
	ALIGNTUNE_OPTIM_8BIT=1 ALIGNTUNE_USE_GC=1 TOKENIZERS_PARALLELISM=false python -m scripts.train_pref --config configs/base.yaml --preset balanced --algo simpo --beta 2.0 --sft_ckpt outputs/sft/Llama-3.1-8B-Instruct-lora --autosave_steps 50
	TOKENIZERS_PARALLELISM=false python -m scripts.mine_hard_pairs --ckpt outputs/simpo/Llama-3.1-8B-Instruct-lora-simpo --in_file data/pack/dpo.jsonl --out_file data/pack/dpo.hard15k.jsonl --top_k 15000 --max_length 1024
	ALIGNTUNE_OPTIM_8BIT=1 ALIGNTUNE_USE_GC=1 TOKENIZERS_PARALLELISM=false python -m scripts.train_pref --config configs/base.yaml --preset balanced --algo dpo --beta 0.1 --sft_ckpt outputs/simpo/Llama-3.1-8B-Instruct-lora-simpo --train_file data/pack/dpo.hard15k.jsonl --autosave_steps 50
	python -m scripts.split_jsonl_eval --inp data/pack/sft.jsonl --out data/pack/sft.eval.400.jsonl --n 400 --bins 8
	python -m scripts.build_long_eval --inp data/pack/sft.jsonl --out data/pack/sft.eval.long100.jsonl --n 100
	TOKENIZERS_PARALLELISM=false python -m scripts.run_ablation --config configs/base.yaml --eval_file data/pack/sft.eval.400.jsonl --ckpt outputs/sft/Llama-3.1-8B-Instruct-lora outputs/simpo/Llama-3.1-8B-Instruct-lora-simpo outputs/dpo/Llama-3.1-8B-Instruct-lora-dpo --labels SFT SimPO DPO --out reports/ablation_summary.json
	TOKENIZERS_PARALLELISM=false python -m scripts.run_ablation --config configs/base.yaml --eval_file data/pack/sft.eval.long100.jsonl --batch_size 2 --ckpt outputs/sft/Llama-3.1-8B-Instruct-lora outputs/simpo/Llama-3.1-8B-Instruct-lora-simpo outputs/dpo/Llama-3.1-8B-Instruct-lora-dpo --labels "SFT (long)" "SimPO (long)" "DPO (long)" --out reports/ablation_long_summary.json
