# ===========================
# Git Attributes - Best Practices
# ===========================

# Auto detect text files and normalize line endings
* text=auto

# ===========================
# Source Code
# ===========================

# Python
*.py text diff=python eol=lf
*.pyx text diff=python eol=lf
*.pxd text diff=python eol=lf
*.pyi text diff=python eol=lf

# Shell scripts (must be LF for Unix compatibility)
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf

# Batch scripts (must be CRLF for Windows)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# ===========================
# Configuration Files
# ===========================

*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf

# Makefiles (must be LF)
Makefile text eol=lf
makefile text eol=lf
*.mk text eol=lf

# ===========================
# Documentation
# ===========================

*.md text diff=markdown eol=lf
*.txt text eol=lf
*.rst text eol=lf
*.adoc text eol=lf
LICENSE text eol=lf
AUTHORS text eol=lf
CHANGELOG text eol=lf
CONTRIBUTING text eol=lf

# ===========================
# Web / Frontend
# ===========================

*.html text diff=html eol=lf
*.htm text diff=html eol=lf
*.css text diff=css eol=lf
*.scss text eol=lf
*.sass text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# ===========================
# Data Files
# ===========================

# CSV/TSV (text, but may have specific line endings)
*.csv text eol=lf
*.tsv text eol=lf

# SQL
*.sql text eol=lf

# ===========================
# Binary Files (do not diff)
# ===========================

# Archives
*.7z binary
*.gz binary
*.tar binary
*.tgz binary
*.zip binary
*.bz2 binary
*.xz binary

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text eol=lf

# Documents
*.pdf binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.ppt binary
*.pptx binary

# Fonts
*.ttf binary
*.eot binary
*.woff binary
*.woff2 binary
*.otf binary

# Machine Learning / Data Science
*.pkl binary
*.pickle binary
*.joblib binary
*.npy binary
*.npz binary
*.h5 binary
*.hdf5 binary
*.parquet binary
*.feather binary
*.arrow binary

# PyTorch / TensorFlow
*.pt binary
*.pth binary
*.onnx binary
*.pb binary
*.tflite binary

# Compiled
*.pyc binary
*.pyo binary
*.so binary
*.dll binary
*.dylib binary
*.exe binary

# ===========================
# Git LFS (Large File Storage)
# ===========================
# Uncomment if using Git LFS for large files

# *.xlsx filter=lfs diff=lfs merge=lfs -text
# *.parquet filter=lfs diff=lfs merge=lfs -text
# *.pt filter=lfs diff=lfs merge=lfs -text
# *.pth filter=lfs diff=lfs merge=lfs -text

# ===========================
# Linguist Overrides
# ===========================
# Control language statistics on GitHub

# Exclude generated files from language stats
**/generated/** linguist-generated=true

# Mark vendored files
**/vendor/** linguist-vendored=true

# Mark documentation
docs/** linguist-documentation=true

# Ensure Python is detected correctly
*.py linguist-language=Python

# ===========================
# Diff Settings
# ===========================

# Use custom diff drivers for specific file types
*.ipynb diff=jupyter
requirements*.txt diff=text
